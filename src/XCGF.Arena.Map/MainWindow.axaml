<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
        xmlns:editor="using:NodeEditor.Controls"
        x:Class="XCGF.Arena.Map.MainWindow"
        Title="XCGF.Arena - Carte"
        Width="1600" Height="900">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Scénario" VerticalAlignment="Center" />
        <ComboBox x:Name="ScenarioBox" VerticalAlignment="Center" MinWidth="220" />
        <Button x:Name="PlayButton" Content="▶ Play" Click="OnPlay" Margin="16,0,0,0" />
        <Button x:Name="PauseButton" Content="⏸ Pause" Click="OnPause" />
        <Button x:Name="StopButton" Content="⏹ Stop" Click="OnStop" />
        <TextBlock Text="Vitesse" VerticalAlignment="Center" Margin="16,0,0,0" />
        <ComboBox x:Name="SpeedBox" SelectedIndex="1" SelectionChanged="OnSpeedChanged" VerticalAlignment="Center">
          <ComboBoxItem Content="x1" Tag="1" />
          <ComboBoxItem Content="x10" Tag="10" />
          <ComboBoxItem Content="x60" Tag="60" />
        </ComboBox>
        <TextBlock x:Name="ClockText" VerticalAlignment="Center" Margin="16,0,0,0" FontFamily="monospace" />
        <TextBlock x:Name="StateText" VerticalAlignment="Center" Margin="16,0,0,0" />
      </StackPanel>
    </Border>
    <Grid x:Name="Body" ColumnDefinitions="2*,4,3*">
      <mapsui:MapControl x:Name="MapView" Grid.Column="0" />

      <GridSplitter x:Name="BlueprintSplitter" Grid.Column="1" ResizeDirection="Columns" Background="#3A3B42" />

      <!-- Blueprint graphs: wheel to zoom, middle button to pan -->
      <DockPanel x:Name="BlueprintPanel" Grid.Column="2">
        <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Blueprint" VerticalAlignment="Center" />
            <ComboBox x:Name="GraphBox" VerticalAlignment="Center" MinWidth="240" SelectionChanged="OnGraphChanged" />
            <Button Content="Cadrer" Click="OnFitGraph" />
          </StackPanel>
        </Border>
        <Grid RowDefinitions="3*,4,*">
          <Border Grid.Row="0" Background="#1E1F24">
            <editor:Editor x:Name="GraphEditor" />
          </Border>
          <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="#3A3B42" />
          <ListBox x:Name="LogList" Grid.Row="2" FontFamily="monospace" FontSize="12">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
          </ListBox>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
